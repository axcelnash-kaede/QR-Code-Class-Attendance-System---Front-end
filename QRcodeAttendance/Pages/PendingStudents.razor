@page "/pending-students"
@using MudBlazor
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using QRcodeAttendance.Services
@inject HttpClient http
@inject IJSRuntime JS
@inject NavigationManager nav
@inject ISnackbar Snackbar

<div class="pending-page">
    <div class="pending-card">

        <div class="pending-header">
            <div>
                <h1>Student Registration Approval</h1>
                <p>Review, approve, or reject student accounts registered from the mobile app.</p>
            </div>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Class="pending-refresh"
                       OnClick="LoadPendingStudentsAsync">
                Refresh
            </MudButton>
        </div>

        @if (isLoading)
        {
            <div class="pending-empty">Loading pending students...</div>
        }
        else if (!pendingStudents.Any())
        {
            <div class="pending-empty">No pending student registrations.</div>
        }
        else
        {
            <div class="pending-table-card">
                <MudTable T="PendingStudentDto"
                          Items="@pendingStudents"
                          Dense="true"
                          Bordered="true"
                          Striped="true">

                    <HeaderContent>
                        <MudTh>Student ID</MudTh>
                        <MudTh>Name</MudTh>
                        <MudTh>Email</MudTh>
                        <MudTh>Section</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>

                    <RowTemplate Context="student">
                        <MudTd>@student.StudentId</MudTd>
                        <MudTd>@student.FullName</MudTd>
                        <MudTd>@student.Email</MudTd>
                        <MudTd>@student.SectionName</MudTd>
                        <MudTd>@student.ApprovalStatus</MudTd>
                        <MudTd>
                            <div class="pending-actions">
                                <MudButton Color="Color.Success"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                           Class="approve-btn"
                                           Disabled="@isProcessing"
                                           OnClick="@(() => ApproveStudentAsync(student.Id))">
                                    Approve
                                </MudButton>

                                <MudButton Color="Color.Error"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                           Class="reject-btn"
                                           Disabled="@isProcessing"
                                           OnClick="@(() => RejectStudentAsync(student.Id))">
                                    Reject
                                </MudButton>
                            </div>
                        </MudTd>
                    </RowTemplate>

                </MudTable>
            </div>
        }

        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   Class="pending-back"
                   OnClick="@(() => nav.NavigateTo("/main_dashboard"))">
            Back to Dashboard
        </MudButton>

    </div>
</div>

@code {
    private bool isLoading;
    private bool isProcessing;

    private List<PendingStudentDto> pendingStudents = new();

    protected override async Task OnInitializedAsync()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");

        if (string.IsNullOrWhiteSpace(token))
        {
            nav.NavigateTo("/login");
            return;
        }

        http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        await LoadPendingStudentsAsync();
    }

    private async Task LoadPendingStudentsAsync()
    {
        try
        {
            isLoading = true;

            var result = await http.GetFromJsonAsync<List<PendingStudentDto>>(
                $"{ApiConfig.BaseUrl}/api/Auth/pending-students"
            );

            pendingStudents = result ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load pending students: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ApproveStudentAsync(int userId)
    {
        try
        {
            isProcessing = true;

            var response = await http.PutAsync(
                $"{ApiConfig.BaseUrl}/api/Auth/approve-student/{userId}",
                null
            );

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Student approved successfully.", Severity.Success);
                await LoadPendingStudentsAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(error) ? "Failed to approve student." : error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to approve student: {ex.Message}", Severity.Error);
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RejectStudentAsync(int userId)
    {
        try
        {
            isProcessing = true;

            var response = await http.PutAsync(
                $"{ApiConfig.BaseUrl}/api/Auth/reject-student/{userId}",
                null
            );

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Student rejected successfully.", Severity.Success);
                await LoadPendingStudentsAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add(string.IsNullOrWhiteSpace(error) ? "Failed to reject student." : error, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to reject student: {ex.Message}", Severity.Error);
        }
        finally
        {
            isProcessing = false;
        }
    }

    public class PendingStudentDto
    {
        public int Id { get; set; }
        public string StudentId { get; set; } = "";
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public int? SectionId { get; set; }
        public string SectionName { get; set; } = "";
        public string ApprovalStatus { get; set; } = "";
    }
}