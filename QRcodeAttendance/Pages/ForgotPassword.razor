@page "/forgot-password"
@inject HttpClient http
@inject NavigationManager nav
@inject ISnackbar Snackbar

@using MudBlazor
@using System.Net.Http.Json
@using QRcodeAttendance.Services

<div class="forgot-page">
    <div class="forgot-card">

        <div class="forgot-icon">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" />
        </div>

        <h1>Forgot Password</h1>

        <p>
            Enter your registered email. We’ll send an OTP code so you can reset your password.
        </p>

        <MudTextField T="string"
                      Label="Email Address"
                      @bind-Value="email"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Email" />

        <MudButton FullWidth="true"
                   Variant="Variant.Filled"
                   Disabled="@isSendingOtp"
                   Class="forgot-main-btn"
                   OnClick="SendOtp">
            @(isSendingOtp ? "Sending OTP..." : "Send OTP")
        </MudButton>

        <div class="forgot-divider">
            <span>Verify OTP</span>
        </div>

        <MudTextField T="string"
                      Label="OTP Code"
                      @bind-Value="otp"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Pin" />

        <MudTextField T="string"
                      Label="New Password"
                      @bind-Value="newPassword"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      FullWidth="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Lock" />

        <MudButton FullWidth="true"
                   Variant="Variant.Filled"
                   Disabled="@isResetting"
                   Class="forgot-success-btn"
                   OnClick="ResetPassword">
            @(isResetting ? "Resetting..." : "Reset Password")
        </MudButton>

        <MudButton FullWidth="true"
                   Variant="Variant.Text"
                   Class="forgot-back-btn"
                   OnClick="@(() => nav.NavigateTo("/login"))">
            Back to Login
        </MudButton>

    </div>
</div>

@code {
    private string email = "";
    private string otp = "";
    private string newPassword = "";

    private bool isSendingOtp;
    private bool isResetting;

    private async Task SendOtp()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            Snackbar.Add("Email is required.", Severity.Warning);
            return;
        }

        isSendingOtp = true;

        try
        {
            var response = await http.PostAsJsonAsync(
                $"{ApiConfig.BaseUrl}/api/Auth/forgot-password/send-otp",
                new { email = email.Trim() });

            if (response.IsSuccessStatusCode)
                Snackbar.Add("OTP sent to your email.", Severity.Success);
            else
                Snackbar.Add(await response.Content.ReadAsStringAsync(), Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Cannot connect to backend: {ex.Message}", Severity.Error);
        }
        finally
        {
            isSendingOtp = false;
        }
    }

    private async Task ResetPassword()
    {
        if (string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(otp) ||
            string.IsNullOrWhiteSpace(newPassword))
        {
            Snackbar.Add("Complete all fields first.", Severity.Warning);
            return;
        }

        isResetting = true;

        try
        {
            var response = await http.PostAsJsonAsync(
                $"{ApiConfig.BaseUrl}/api/Auth/forgot-password/reset",
                new
                {
                    email = email.Trim(),
                    otp = otp.Trim(),
                    newPassword = newPassword
                });

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Password reset successfully.", Severity.Success);
                nav.NavigateTo("/login");
            }
            else
            {
                Snackbar.Add(await response.Content.ReadAsStringAsync(), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Cannot connect to backend: {ex.Message}", Severity.Error);
        }
        finally
        {
            isResetting = false;
        }
    }
}