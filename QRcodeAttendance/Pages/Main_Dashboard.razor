    private async Task SetupRealtimeAttendanceAsync()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl($"{ApiConfig.BaseUrl}/notificationHub")
                .WithAutomaticReconnect()
                .Build();

            hubConnection.On<int>("AttendanceUpdated", async sessionId =>
            {
                await InvokeAsync(async () =>
                {
                    if (sessionId == currentSessionId || sessionId == activeSessionId)
                    {
                        await LoadAttendanceBySessionAsync(sessionId, false);
                        await LoadDashboardAsync();

                        StateHasChanged();
                        Snackbar.Add("New attendance record received.", Severity.Success);
                    }
                });
            });

            await hubConnection.StartAsync();
        }
        catch
        {
            Snackbar.Add("Realtime connection failed, but dashboard can still work.", Severity.Warning);
        }
    }

    private async Task OpenExcuseModal(AttendanceRow row)
    {
        if (row.Status != "Absent" && row.Status != "Late")
            return;

        try
        {
            var response = await http.GetAsync(
                $"{ApiConfig.BaseUrl}/api/attendance/excuse?studentId={row.StudentUserId}&sessionId={currentSessionId}"
            );

            var body = await response.Content.ReadAsStringAsync();

            if (string.IsNullOrWhiteSpace(body))
            {
                Snackbar.Add("No response from server.", Severity.Warning);
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add(CleanApiError(body, "Failed to load excuse letter."), Severity.Error);
                return;
            }

            selectedExcuse = System.Text.Json.JsonSerializer.Deserialize<ExcuseViewDto>(
                body,
                new System.Text.Json.JsonSerializerOptions
                {
                    PropertyNameCaseInsensitive = true
                }
            );

            if (selectedExcuse == null || !selectedExcuse.Found)
            {
                Snackbar.Add("No excuse letter submitted for this absent student.", Severity.Info);
                return;
            }

            showExcuseModal = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load excuse letter: {ex.Message}", Severity.Error);
        }
    }

    private async Task ApproveExcuseAsync(int id)
    {
        await ProcessExcuseDecisionAsync(id, true);
    }

    private async Task RejectExcuseAsync(int id)
    {
        await ProcessExcuseDecisionAsync(id, false);
    }

    private async Task ProcessExcuseDecisionAsync(int id, bool isApproved)
    {
        if (id <= 0)
        {
            Snackbar.Add("Invalid excuse request.", Severity.Warning);
            return;
        }

        isProcessingExcuse = true;

        try
        {
            var endpoint = isApproved
                ? "approve-excuse"
                : "reject-excuse";

            var response = await http.PostAsync(
                $"{ApiConfig.BaseUrl}/api/attendance/{endpoint}?id={id}",
                null
            );

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();

                Snackbar.Add(
                    CleanApiError(error, "Failed to update excuse request."),
                    Severity.Error
                );

                return;
            }

            Snackbar.Add(
                isApproved
                    ? "Excuse approved successfully."
                    : "Excuse rejected successfully.",
                isApproved ? Severity.Success : Severity.Info
            );

            showExcuseModal = false;
            selectedExcuse = null;

            await LoadAttendanceBySessionAsync(currentSessionId, false);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to update excuse request: {ex.Message}", Severity.Error);
        }
        finally
        {
            isProcessingExcuse = false;
        }
    }

    private async Task PrintPdfAsync()
    {
        if (currentSessionId <= 0 || !attendanceList.Any())
        {
            Snackbar.Add("No attendance records to print.", Severity.Warning);
            return;
        }

        var reportData = new
        {
            title = tableTitle,
            sessionId = currentSessionId,
            printedAt = DateTime.Now.ToString("MMM dd, yyyy hh:mm tt"),
            totalStudents = attendanceList.Count,
            presentCount = attendanceList.Count(x => x.Status == "Present"),
            lateCount = attendanceList.Count(x => x.Status == "Late"),
            absentCount = attendanceList.Count(x => x.Status == "Absent"),
            excusedCount = attendanceList.Count(x => x.Status == "Excused"),

            records = attendanceList.Select(x => new
            {
                studentId = FormatStudentId(x.StudentId),
                name = x.Name,
                status = x.Status,
                time = ToPhilippineTime(x.Time)
            }).ToList()
        };

        await JS.InvokeVoidAsync("qrAttendancePrintPdf", reportData);
    }

    private string CleanApiError(string? error, string fallback)
    {
        if (string.IsNullOrWhiteSpace(error))
            return fallback;

        if (error.Contains("<!DOCTYPE", StringComparison.OrdinalIgnoreCase) ||
            error.Contains("Microsoft.AspNetCore", StringComparison.OrdinalIgnoreCase) ||
            error.Contains("System.", StringComparison.OrdinalIgnoreCase) ||
            error.Length > 400)
        {
            return "Server error. Please check the backend console.";
        }

        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(error);

            if (doc.RootElement.TryGetProperty("message", out var messageElement))
            {
                var msg = messageElement.GetString();

                if (!string.IsNullOrWhiteSpace(msg))
                    return msg;
            }

            if (doc.RootElement.TryGetProperty("title", out var titleElement))
            {
                var title = titleElement.GetString();

                if (!string.IsNullOrWhiteSpace(title))
                    return title;
            }
        }
        catch
        {
            // Not JSON, return plain text
        }

        return error;
    }

    private string FormatStudentId(string? id)
    {
        if (string.IsNullOrWhiteSpace(id))
            return "-";

        if (id.StartsWith("C24-"))
            return id;

        return $"C24-01-{id}-MAN121";
    }

    private string GetQrImageSource()
    {
        if (string.IsNullOrWhiteSpace(activeQrCode))
            return "";

        if (activeQrCode.StartsWith("data:image", StringComparison.OrdinalIgnoreCase))
            return activeQrCode;

        return $"data:image/png;base64,{activeQrCode}";
    }

    private string GetStatusClass(string status)
    {
        return status switch
        {
            "Present" => "status-present",
            "Late" => "status-late",
            "Absent" => "status-absent",
            "Excused" => "status-excused",
            _ => ""
        };
    }

    private string ToPhilippineTime(string? timeText)
    {
        if (string.IsNullOrWhiteSpace(timeText))
            return "-";

        if (DateTime.TryParse(timeText, out var parsed))
            return parsed.ToString("hh:mm tt");

        return timeText;
    }

    private string GetExcuseImageUrl(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
            return "";

        if (imageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            return imageUrl;

        return $"{ApiConfig.BaseUrl}{imageUrl}";
    }

