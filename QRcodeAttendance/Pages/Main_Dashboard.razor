    private async Task SaveActiveSessionAsync()
    {
        await JS.InvokeVoidAsync("localStorage.setItem", "activeSessionId", activeSessionId.ToString());
        await JS.InvokeVoidAsync("localStorage.setItem", "activeQrToken", activeQrToken ?? "");
        await JS.InvokeVoidAsync("localStorage.setItem", "activeQrCode", activeQrCode ?? "");
        await JS.InvokeVoidAsync("localStorage.setItem", "activeSectionName", activeSectionName ?? "");
        await JS.InvokeVoidAsync("localStorage.setItem", "activeSubjectName", activeSubjectName ?? "");
        await JS.InvokeVoidAsync("localStorage.setItem", "activeSectionId", selectedSectionId?.ToString() ?? "");
        await JS.InvokeVoidAsync("localStorage.setItem", "activeSubjectId", selectedSubjectId?.ToString() ?? "");
        await JS.InvokeVoidAsync("localStorage.setItem", "activeGraceMinutes", activeGraceMinutes.ToString());
        await JS.InvokeVoidAsync("localStorage.setItem", "activeExpirationMinutes", activeExpirationMinutes.ToString());
    }

    private async Task RestoreActiveSessionAsync()
    {
        var sessionId = await JS.InvokeAsync<string>("localStorage.getItem", "activeSessionId");
        var qrCode = await JS.InvokeAsync<string>("localStorage.getItem", "activeQrCode");

        activeQrToken = await JS.InvokeAsync<string>("localStorage.getItem", "activeQrToken") ?? "";

        var graceText = await JS.InvokeAsync<string>("localStorage.getItem", "activeGraceMinutes");
        var expirationText = await JS.InvokeAsync<string>("localStorage.getItem", "activeExpirationMinutes");

        if (int.TryParse(graceText, out var restoredGrace) && restoredGrace > 0)
            activeGraceMinutes = restoredGrace;
        else
            activeGraceMinutes = DefaultGraceMinutes;

        if (int.TryParse(expirationText, out var restoredExpiration) && restoredExpiration > 0)
            activeExpirationMinutes = restoredExpiration;
        else
            activeExpirationMinutes = DefaultExpirationMinutes;

        if (int.TryParse(sessionId, out var parsedSessionId) && parsedSessionId > 0)
        {
            activeSessionId = parsedSessionId;
            currentSessionId = parsedSessionId;
            activeQrCode = qrCode ?? "";

            activeSectionName = await JS.InvokeAsync<string>("localStorage.getItem", "activeSectionName") ?? "";
            activeSubjectName = await JS.InvokeAsync<string>("localStorage.getItem", "activeSubjectName") ?? "";

            selectedSectionName = activeSectionName;
            selectedSubjectName = activeSubjectName;

            var sectionId = await JS.InvokeAsync<string>("localStorage.getItem", "activeSectionId");
            var subjectId = await JS.InvokeAsync<string>("localStorage.getItem", "activeSubjectId");

            if (int.TryParse(sectionId, out var parsedSectionId))
                selectedSectionId = parsedSectionId;

            if (int.TryParse(subjectId, out var parsedSubjectId))
                selectedSubjectId = parsedSubjectId;

            tableTitle = $"{activeSectionName} • {activeSubjectName}";
        }
    }

    private async Task ClearActiveSessionAsync()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "activeSessionId");
        await JS.InvokeVoidAsync("localStorage.removeItem", "activeQrCode");
        await JS.InvokeVoidAsync("localStorage.removeItem", "activeSectionName");
        await JS.InvokeVoidAsync("localStorage.removeItem", "activeSubjectName");
        await JS.InvokeVoidAsync("localStorage.removeItem", "activeSectionId");
        await JS.InvokeVoidAsync("localStorage.removeItem", "activeSubjectId");
        await JS.InvokeVoidAsync("localStorage.removeItem", "activeQrToken");
        await JS.InvokeVoidAsync("localStorage.removeItem", "activeGraceMinutes");
        await JS.InvokeVoidAsync("localStorage.removeItem", "activeExpirationMinutes");
    }

    private async Task HandleLogout()
    {
        await JS.InvokeVoidAsync("localStorage.removeItem", "token");
        await JS.InvokeVoidAsync("localStorage.removeItem", "userEmail");
        await JS.InvokeVoidAsync("localStorage.removeItem", "userName");
        await JS.InvokeVoidAsync("localStorage.removeItem", "role");

        await JS.InvokeVoidAsync("localStorage.removeItem", "teacher_profile_picture");

        await ClearActiveSessionAsync();

        nav.NavigateTo("/login", true);
    }

