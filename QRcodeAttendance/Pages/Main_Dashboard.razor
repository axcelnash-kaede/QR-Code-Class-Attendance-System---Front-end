@page "/main_dashboard"

@using MudBlazor
@using System.Net.Http.Headers
@using System.Net.Http.Json
@using QRcodeAttendance.Services
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Forms

@inject NavigationManager nav
@inject IJSRuntime JS
@inject HttpClient http
@inject ISnackbar Snackbar

@implements IAsyncDisposable

<div class="dashboard-wrapper">
    <div class="dashboard-container">

        <!-- SIDEBAR -->
        <div class="sidebar">
            <div class="sidebar-header">
                <img src="/aclc.png" class="sidebar-logo-img" />
                <div class="sidebar-title">QR Classroom Attendance</div>
                <div class="sidebar-subtitle">Teacher Portal</div>
            </div>

            <div class="sidebar-content">
                <div class="section-title">
                    <MudIcon Icon="@Icons.Material.Filled.Class" />
                    <span>Sections</span>
                </div>

                @if (isLoadingSections)
                {
                    <div class="sidebar-empty-state">Loading sections...</div>
                }
                else if (!sections.Any())
                {
                    <div class="sidebar-empty-state">No sections or subjects found.</div>
                }
                else
                {
                    <MudExpansionPanels Elevation="0">
                        @foreach (var sec in sections)
                        {
                            <MudExpansionPanel Text="@sec.SectionName">
                                @foreach (var subject in sec.Subjects)
                                {
                                    <MudButton FullWidth="true"
                                               Class="subject-btn"
                                               StartIcon="@Icons.Material.Filled.MenuBook"
                                               OnClick="@(() => SelectSectionSubject(sec, subject))">
                                        @subject.SubjectName
                                    </MudButton>
                                }
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                }

                <MudExpansionPanels Elevation="0" Class="history-panel">
                    <MudExpansionPanel Text="Session History">
                        @if (isLoadingHistory)
                        {
                            <div class="sidebar-empty-state">Loading history...</div>
                        }
                        else if (!sessionHistory.Any())
                        {
                            <div class="sidebar-empty-state">No session history yet.</div>
                        }
                        else
                        {
                            <div class="history-scroll">
                                @foreach (var session in sessionHistory)
                                {
                                    <MudButton FullWidth="true"
                                               Class="subject-btn history-btn"
                                               StartIcon="@Icons.Material.Filled.History"
                                               OnClick="@(() => ViewSessionHistoryAsync(session))">
                                        <div class="history-item">
                                            <span>@session.SectionName • @session.SubjectName</span>
                                            <small>
                                                Session #@GetTeacherSessionNo(session) • @(session.IsClosed ? "Closed" : "Active")
                                            </small>
                                        </div>
                                    </MudButton>
                                }
                            </div>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </div>

            <MudButton Variant="Variant.Filled"
                       Class="logout-btn"
                       StartIcon="@Icons.Material.Filled.Logout"
                       OnClick="HandleLogout">
                Log Out
            </MudButton>
        </div>

        <!-- MAIN PANEL -->
        <div class="main-panel">

            <!-- SUMMARY CARDS -->
            <div class="summary-grid">
                <div class="summary-card">
                    <div class="summary-icon">
                        <MudIcon Icon="@Icons.Material.Filled.Groups" />
                    </div>
                    <div class="summary-label">Total Students</div>
                    <div class="summary-value">@dashboard.TotalStudents</div>
                </div>

                <div class="summary-card">
                    <div class="summary-icon">
                        <MudIcon Icon="@Icons.Material.Filled.EventNote" />
                    </div>
                    <div class="summary-label">Total Sessions</div>
                    <div class="summary-value">@dashboard.TotalSessions</div>
                </div>

                <div class="summary-card">
                    <div class="summary-icon">
                        <MudIcon Icon="@Icons.Material.Filled.QrCode2" />
                    </div>
                    <div class="summary-label">Active Sessions</div>
                    <div class="summary-value">@dashboard.ActiveSessions</div>
                </div>

                <div class="summary-card">
                    <div class="summary-icon">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" />
                    </div>
                    <div class="summary-label">Closed Sessions</div>
                    <div class="summary-value">@dashboard.ClosedSessions</div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <MudAlert Severity="@messageSeverity"
                          Variant="Variant.Filled"
                          Dense="true"
                          Style="margin-bottom:14px;">
                    @message
                </MudAlert>
            }

            <!-- ACTION BAR -->
            <div class="top-bar">

                <div class="top-bar-left">

                    <div class="session-title-box">
                        <div class="top-label">Attendance Session</div>

                        <div class="title">
                            @(string.IsNullOrWhiteSpace(tableTitle)
                                                        ? "Select a Section"
                                                        : tableTitle)
                        </div>
                    </div>

                    <div class="logged-user-card">

                        <label class="logged-profile-picture-wrap">
                            <img class="logged-profile-picture"
                                 src="@GetProfilePicture()"
                                 alt="Profile" />

                            <InputFile class="hidden-profile-input"
                                       OnChange="@UploadProfilePicture" />
                        </label>

                        <div class="logged-user-info">
                            <div class="info-block">
                                <div class="info-label">Logged In As</div>

                                <div class="info-value">
                                    @DisplayLoggedName()
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="action-bar">

                    <MudButton Class="qr-btn"
                               StartIcon="@Icons.Material.Filled.QrCode2"
                               Disabled="@(!CanGenerateQr || isGeneratingQr || HasActiveSession)"
                               OnClick="GenerateQrAsync">
                        @(isGeneratingQr ? "Generating..." : "Generate QR")
                    </MudButton>

                    <MudButton Class="glass-action-btn"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="RefreshAttendanceAsync">
                        Refresh Table
                    </MudButton>

                    <MudButton Class="glass-action-btn"
                               StartIcon="@Icons.Material.Filled.Visibility"
                               Disabled="@(!HasActiveSession)"
                               OnClick="OpenQrModal">
                        View QR
                    </MudButton>

                    <MudButton Class="close-action-btn"
                               StartIcon="@Icons.Material.Filled.StopCircle"
                               Disabled="@(!HasActiveSession || isClosingSession)"
                               OnClick="CloseSessionAsync">
                        @(isClosingSession ? "Closing..." : "Close Session")
                    </MudButton>

                    <MudButton Class="pdf-btn"
                               StartIcon="@Icons.Material.Filled.PictureAsPdf"
                               Disabled="@(!attendanceList.Any())"
                               OnClick="PrintPdfAsync">
                        Export PDF
                    </MudButton>

                </div>

            </div>

            <!-- ATTENDANCE TABLE -->
            <div class="table-card">
                @if (isLoadingAttendance)
                {
                    <div class="empty-state">Loading attendance records...</div>
                }
                else if (attendanceList.Any())
                {
                    <div class="table-toolbar">
                        <div class="table-subtitle">
                            Showing attendance records for <b>@tableTitle</b>
                        </div>
                    </div>

                    <div class="teacher-table-scroll">
                        <MudTable T="AttendanceRow"
                                  Items="@attendanceList"
                                  Dense="true"
                                  FixedHeader="true"
                                  Height="100%"
                                  Bordered="true"
                                  Striped="true">

                            <HeaderContent>
                                <MudTh>Student ID</MudTh>
                                <MudTh>Name</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh>Time</MudTh>
                            </HeaderContent>

                            <RowTemplate Context="row">
                                <MudTd DataLabel="Student ID">@FormatStudentId(row.StudentId)</MudTd>
                                <MudTd DataLabel="Name">@row.Name</MudTd>

                                <MudTd DataLabel="Status">
                                    @if (row.Status == "Absent" || row.Status == "Late")
                                    {
                                        <span class="status-chip @GetStatusClass(row.Status)"
                                              style="cursor:pointer"
                                              @onclick="() => OpenExcuseModal(row)">
                                            @row.Status
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-chip @GetStatusClass(row.Status)">
                                            @row.Status
                                        </span>
                                    }
                                </MudTd>

                                <MudTd DataLabel="Time">
                                    @ToPhilippineTime(row.Time)
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        No attendance records found for this session.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- QR MODAL -->
@if (showQrModal)
{
    <div class="qr-modal-backdrop" @onclick="CloseQrModal">
        <div class="qr-modal-card" @onclick:stopPropagation="true">
            <div class="qr-modal-header">
                <div>
                    <div class="qr-modal-title">Active QR Session</div>
                    <div class="qr-modal-subtitle">@activeSectionName - @activeSubjectName</div>
                </div>

                <MudButton Variant="Variant.Text" OnClick="CloseQrModal">
                    Close
                </MudButton>
            </div>

            <div class="qr-modal-body">
                @if (!string.IsNullOrWhiteSpace(activeQrCode))
                {
                    <img class="generated-qr-image"
                         src="@GetQrImageSource()"
                         alt="Generated QR Code" />
                }
                else
                {
                    <div class="empty-state">
                        QR image is not available for this restored active session.
                        You can still close this session.
                    </div>
                }

                <div class="qr-session-meta">
                    <div><b>Session ID:</b> @activeSessionId</div>
                    <div><b>Status:</b> Active</div>
                    <div><b>Grace Time:</b> @activeGraceMinutes minutes</div>
                    <div><b>Expiry:</b> @activeExpirationMinutes minutes</div>
                </div>

                <div style="width:100%; display:flex; justify-content:flex-end; gap:10px;">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               OnClick="CloseQrModal">
                        Done
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               Disabled="@isClosingSession"
                               OnClick="CloseSessionAsync">
                        @(isClosingSession ? "Closing..." : "Close Session")
                    </MudButton>
                </div>
            </div>
        </div>
    </div>
}

<!-- EXCUSE MODAL -->
@if (showExcuseModal && selectedExcuse != null)
{
    <div class="qr-modal-backdrop" @onclick="() => showExcuseModal = false">
        <div class="qr-modal-card" @onclick:stopPropagation="true">

            <h3>Excuse Letter</h3>

            <p>
                <b>Student:</b>
                @selectedExcuse.StudentName
            </p>

            <p>
                <b>Status:</b>
                @selectedExcuse.Status
            </p>

            <p>@selectedExcuse.Message</p>

            @if (!string.IsNullOrWhiteSpace(selectedExcuse.ImageUrl))
            {
                <img src="@GetExcuseImageUrl(selectedExcuse.ImageUrl)"
                     style="
                                        width:100%;
                                        max-height:280px;
                                        object-fit:contain;
                                        border-radius:14px;
                                        border:1px solid #e5e7eb;
                                     " />
            }

            @if (selectedExcuse.Status == "Pending")
            {
                <div style="
                                    display:flex;
                                    gap:10px;
                                    justify-content:end;
                                    margin-top:14px;
                                ">

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               Disabled="@isProcessingExcuse"
                               OnClick="@(() => ApproveExcuseAsync(selectedExcuse.Id))">
                        @(isProcessingExcuse ? "Processing..." : "Approve")
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               Disabled="@isProcessingExcuse"
                               OnClick="@(() => RejectExcuseAsync(selectedExcuse.Id))">
                        @(isProcessingExcuse ? "Processing..." : "Reject")
                    </MudButton>
                </div>
            }
            else
            {
                <div style="
                                    margin-top:18px;
                                    padding:12px;
                                    border-radius:12px;
                                    font-weight:700;
                                    text-align:center;
                                    background:@(selectedExcuse.Status == "Approved" ? "#dcfce7" : "#fee2e2");
                                    color:@(selectedExcuse.Status == "Approved" ? "#166534" : "#991b1b");
                                ">
                    @(selectedExcuse.Status == "Approved"
                                ? "This excuse request was approved."
                                : "This excuse request was rejected.")
        </div>
                }
        </div>
    </div>
}

@code {
    private const int DefaultGraceMinutes = 1;
    private const int DefaultExpirationMinutes = 30;

    private bool isLoadingSections;
    private bool isLoadingHistory;
    private bool isLoadingAttendance;
    private bool isGeneratingQr;
    private bool isClosingSession;
    private bool showQrModal;
    private bool showExcuseModal;
    private bool isProcessingExcuse;
    private bool isUploadingProfilePicture;

    private int? selectedSectionId;
    private int? selectedSubjectId;
    private int activeSessionId;
    private int currentSessionId;
    private int activeGraceMinutes = DefaultGraceMinutes;
    private int activeExpirationMinutes = DefaultExpirationMinutes;

    private string selectedSectionName = "";
    private string selectedSubjectName = "";
    private string activeQrCode = "";
    private string activeSectionName = "";
    private string activeSubjectName = "";
    private string activeQrToken = "";
    private string tableTitle = "";
    private string message = "";
    private string? profilePicture;
    private string loggedInName = "";
    private string loggedInRole = "";

    private Severity messageSeverity = Severity.Info;

    private DashboardDto dashboard = new();
    private ExcuseViewDto? selectedExcuse;
    private TeacherProfileModel teacherProfile = new();

    private List<TeacherSectionDto> sections = new();
    private List<SessionHistoryDto> sessionHistory = new();
    private List<AttendanceRow> attendanceList = new();

    private HubConnection? hubConnection;

    private bool HasActiveSession =>
        activeSessionId > 0;

    private bool CanGenerateQr =>
        selectedSectionId.HasValue && selectedSubjectId.HasValue;

        private int GetTeacherSessionNo(SessionHistoryDto session)
{
    if (session == null || session.Id <= 0)
        return 0;

    var ordered = sessionHistory
        .OrderBy(x => x.Id)
        .ToList();

    var index = ordered.FindIndex(x => x.Id == session.Id);

    return index >= 0 ? index + 1 : 0;
}

    protected override async Task OnInitializedAsync()
    {
        var token = await GetTokenAsync();

        if (string.IsNullOrWhiteSpace(token))
        {
            nav.NavigateTo("/login");
            return;
        }

        SetAuthHeader(token);

        await LoadLoggedInUserAsync();
        await LoadTeacherProfileAsync();

        profilePicture = await JS.InvokeAsync<string>(
            "localStorage.getItem",
            GetProfilePictureStorageKey()
        );

        await RestoreActiveSessionAsync();
        await LoadDashboardAsync();
        await LoadSectionsAsync();
        await LoadSessionHistoryAsync();
        await RecoverActiveSessionFromHistoryAsync();
        await SetupRealtimeAttendanceAsync();

        if (HasActiveSession)
        {
            currentSessionId = activeSessionId;
            tableTitle = $"{activeSectionName} • {activeSubjectName}";

            await LoadAttendanceBySessionAsync(activeSessionId, false);
        }
    }

    private string GetProfilePictureStorageKey()
    {
        if (teacherProfile.Id > 0)
            return $"teacher_profile_picture_{teacherProfile.Id}";

        if (!string.IsNullOrWhiteSpace(teacherProfile.Email))
            return $"teacher_profile_picture_{teacherProfile.Email}";

        return $"teacher_profile_picture_{loggedInName}";
    }

    private async Task LoadLoggedInUserAsync()
    {
        loggedInName = await JS.InvokeAsync<string>("localStorage.getItem", "userName") ?? "";
        loggedInRole = await JS.InvokeAsync<string>("localStorage.getItem", "role") ?? "";
    }

    private async Task LoadTeacherProfileAsync()
    {
        try
        {
            var result = await http.GetFromJsonAsync<TeacherProfileModel>(
                $"{ApiConfig.BaseUrl}/api/Users/me/teacher-profile"
            );

            if (result != null)
            {
                teacherProfile = result;
                loggedInName = result.FullName;
                loggedInRole = result.Role;

                await JS.InvokeVoidAsync("localStorage.setItem", "userName", result.FullName);
                await JS.InvokeVoidAsync("localStorage.setItem", "role", result.Role);
            }
        }
        catch
        {
            Snackbar.Add("Failed to load teacher profile.", Severity.Warning);
        }
    }

    private async Task RecoverActiveSessionFromHistoryAsync()
    {
        if (HasActiveSession)
            return;

        var active = sessionHistory.FirstOrDefault(x => x.IsActive && !x.IsClosed);

        if (active == null)
            return;

        activeSessionId = active.SessionId;
        currentSessionId = active.SessionId;

        activeSectionName = active.SectionName;
        activeSubjectName = active.SubjectName;

        selectedSectionId = active.SectionId;
        selectedSubjectId = active.SubjectId;
        selectedSectionName = active.SectionName;
        selectedSubjectName = active.SubjectName;

        tableTitle = $"{active.SectionName} • {active.SubjectName}";

        activeQrCode = "";
        activeQrToken = "";

        await SaveActiveSessionAsync();
    }

    private string GetProfilePicture()
    {
        if (!string.IsNullOrWhiteSpace(profilePicture))
            return profilePicture;

        if (!string.IsNullOrWhiteSpace(teacherProfile.ProfileImageUrl))
            return GetProfileImageSource(teacherProfile.ProfileImageUrl);

        return "/aclc.png";
    }

    private string DisplayLoggedName()
    {
        if (!string.IsNullOrWhiteSpace(loggedInName))
            return loggedInName;

        return "Teacher";
    }

    private string GetLoggedInitial()
    {
        var value = DisplayLoggedName();

        if (string.IsNullOrWhiteSpace(value))
            return "T";

        return value.Trim()[0].ToString().ToUpper();
    }

    private string GetProfileImageSource(string? imageUrl)
    {
        if (string.IsNullOrWhiteSpace(imageUrl))
            return "/aclc.png";

        if (imageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase))
            return imageUrl;

        return $"{ApiConfig.BaseUrl}{imageUrl}";
    }

    private async Task UploadProfilePicture(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;

            if (file == null)
                return;

            if (file.Size > 5 * 1024 * 1024)
            {
                Snackbar.Add("Image must be 5MB or below.", Severity.Warning);
                return;
            }

            using var stream = file.OpenReadStream(5 * 1024 * 1024);
            using var ms = new MemoryStream();

            await stream.CopyToAsync(ms);

            var bytes = ms.ToArray();
            var base64 = Convert.ToBase64String(bytes);

            profilePicture = $"data:{file.ContentType};base64,{base64}";

            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                GetProfilePictureStorageKey(),
                profilePicture
            );

            await JS.InvokeVoidAsync(
                "localStorage.removeItem",
                "teacher_profile_picture"
            );

            Snackbar.Add("Profile picture updated.", Severity.Success);

            StateHasChanged();
        }
        catch
        {
            Snackbar.Add("Failed to upload profile picture.", Severity.Error);
        }
    }

    private async Task UploadTeacherProfilePicture(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file == null)
            return;

        if (file.Size > 3 * 1024 * 1024)
        {
            Snackbar.Add("Image must be 3MB or below.", Severity.Warning);
            return;
        }

        isUploadingProfilePicture = true;

        try
        {
            using var content = new MultipartFormDataContent();

            var stream = file.OpenReadStream(maxAllowedSize: 3 * 1024 * 1024);
            var fileContent = new StreamContent(stream);

            fileContent.Headers.ContentType =
                new MediaTypeHeaderValue(file.ContentType);

            content.Add(fileContent, "file", file.Name);

            var response = await http.PostAsync(
                $"{ApiConfig.BaseUrl}/api/Profile/upload-picture",
                content
            );

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();

                Snackbar.Add(
                    CleanApiError(error, "Upload failed."),
                    Severity.Error
                );

                return;
            }

            Snackbar.Add("Profile picture updated.", Severity.Success);

            await LoadTeacherProfileAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            isUploadingProfilePicture = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    private void SelectSectionSubject(TeacherSectionDto section, TeacherSubjectDto subject)
    {
        selectedSectionId = section.SectionId;
        selectedSectionName = section.SectionName;

        selectedSubjectId = subject.SubjectId;
        selectedSubjectName = subject.SubjectName;

        tableTitle = $"{selectedSectionName} • {selectedSubjectName}";
        message = "";

        if (!HasActiveSession)
        {
            currentSessionId = 0;
            attendanceList = new();
        }
    }

    private async Task ViewSessionHistoryAsync(SessionHistoryDto session)
    {
        currentSessionId = session.SessionId;

        selectedSectionId = session.SectionId;
        selectedSubjectId = session.SubjectId;
        selectedSectionName = session.SectionName;
        selectedSubjectName = session.SubjectName;

        tableTitle = $"{session.SectionName} • {session.SubjectName}";
        message = $"Viewing session #{GetTeacherSessionNo(session)}";
        messageSeverity = Severity.Info;

        if (session.IsActive && !session.IsClosed)
        {
            activeSessionId = session.SessionId;
            activeSectionName = session.SectionName;
            activeSubjectName = session.SubjectName;

            activeQrCode = "";
            activeQrToken = "";

            await SaveActiveSessionAsync();
        }
        else
        {
            if (activeSessionId == session.SessionId)
            {
                activeSessionId = 0;
                activeQrCode = "";
                activeQrToken = "";
                activeSectionName = "";
                activeSubjectName = "";

                await ClearActiveSessionAsync();
            }
        }

        await LoadAttendanceBySessionAsync(session.SessionId);
        await LoadDashboardAsync();

        StateHasChanged();
    }

    private async Task LoadDashboardAsync()
    {
        try
        {
            var result = await http.GetFromJsonAsync<DashboardDto>(
                $"{ApiConfig.BaseUrl}/api/Dashboard/teacher"
            );

            if (result != null)
            {
                dashboard = result;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            dashboard = new();
            Snackbar.Add($"Failed to load dashboard stats: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadSectionsAsync()
    {
        try
        {
            isLoadingSections = true;

            var result = await http.GetFromJsonAsync<List<TeacherSectionDto>>(
                $"{ApiConfig.BaseUrl}/api/attendance/teacher-sections-subjects"
            );

            sections = result ?? new();
        }
        catch (Exception ex)
        {
            sections = new();
            Snackbar.Add($"Failed to load sections: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoadingSections = false;
        }
    }

    private async Task LoadSessionHistoryAsync()
    {
        try
        {
            isLoadingHistory = true;

            var result = await http.GetFromJsonAsync<List<SessionHistoryDto>>(
                $"{ApiConfig.BaseUrl}/api/attendance/session-history"
            );

            sessionHistory = result ?? new();
        }
        catch (Exception ex)
        {
            sessionHistory = new();
            Snackbar.Add($"Failed to load session history: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoadingHistory = false;
        }
    }

    private async Task LoadAttendanceBySessionAsync(int sessionId, bool showError = true)
    {
        if (sessionId <= 0)
        {
            attendanceList = new();
            return;
        }

        try
        {
            isLoadingAttendance = true;

            var result = await http.GetFromJsonAsync<List<AttendanceRow>>(
               $"{ApiConfig.BaseUrl}/api/attendance/session/{sessionId}/records"
            );

            attendanceList = result ?? new();
        }
        catch (Exception ex)
        {
            attendanceList = new();

            if (showError)
                Snackbar.Add($"Failed to load attendance records: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoadingAttendance = false;
        }
    }

    private async Task GenerateQrAsync()
    {
        if (!CanGenerateQr)
        {
            Snackbar.Add("Select a section and subject first.", Severity.Warning);
            return;
        }

        if (HasActiveSession)
        {
            Snackbar.Add("You already have an active session. Close it first before generating a new QR.", Severity.Warning);
            return;
        }

        isGeneratingQr = true;

        try
        {
            activeGraceMinutes = DefaultGraceMinutes;
            activeExpirationMinutes = DefaultExpirationMinutes;

            var payload = new CreateSessionRequest
            {
                Title = $"{selectedSectionName} - {selectedSubjectName}",
                SectionId = selectedSectionId!.Value,
                SubjectId = selectedSubjectId!.Value,
                GraceMinutes = activeGraceMinutes,
                ExpirationMinutes = activeExpirationMinutes
            };

            var response = await http.PostAsJsonAsync(
                $"{ApiConfig.BaseUrl}/api/attendance/create-session",
                payload
            );

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();

                Snackbar.Add(
                    CleanApiError(error, "Failed to create session."),
                    Severity.Error
                );

                return;
            }

            var result = await response.Content.ReadFromJsonAsync<CreateSessionResponse>();

            if (result == null || result.SessionId <= 0 || string.IsNullOrWhiteSpace(result.QrCode))
            {
                Snackbar.Add("Session created but QR code was not returned.", Severity.Warning);
                return;
            }

            activeSessionId = result.SessionId;
            currentSessionId = result.SessionId;
            activeQrCode = result.QrCode.Trim();
            activeQrToken = result.QrToken ?? "";

            if (result.GraceMinutes.HasValue && result.GraceMinutes.Value > 0)
                activeGraceMinutes = result.GraceMinutes.Value;

            if (result.ExpirationMinutes.HasValue && result.ExpirationMinutes.Value > 0)
                activeExpirationMinutes = result.ExpirationMinutes.Value;

            activeSectionName = selectedSectionName;
            activeSubjectName = selectedSubjectName;
            tableTitle = $"{activeSectionName} • {activeSubjectName}";

            await SaveActiveSessionAsync();

            showQrModal = true;
            message = "Session created successfully. QR code ready.";
            messageSeverity = Severity.Success;

            Snackbar.Add(message, Severity.Success);

            await LoadDashboardAsync();
            await LoadSessionHistoryAsync();
            await LoadAttendanceBySessionAsync(activeSessionId, false);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"QR generation failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            isGeneratingQr = false;
        }
    }

    private async Task CloseSessionAsync()
    {
        if (activeSessionId <= 0)
        {
            Snackbar.Add("No active session to close.", Severity.Warning);
            return;
        }

        isClosingSession = true;

        try
        {
            var closedSessionId = activeSessionId;

            var closedTitle = !string.IsNullOrWhiteSpace(activeSectionName) &&
                              !string.IsNullOrWhiteSpace(activeSubjectName)
                ? $"{activeSectionName} • {activeSubjectName}"
                : tableTitle;

            var response = await http.PostAsync(
               $"{ApiConfig.BaseUrl}/api/attendance/close?sessionId={closedSessionId}",
                null
            );

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();

                Snackbar.Add(
                    CleanApiError(error, "Failed to close session."),
                    Severity.Error
                );

                return;
            }

            showQrModal = false;

            currentSessionId = closedSessionId;
            tableTitle = closedTitle;

            activeSessionId = 0;
            activeQrCode = "";
            activeSectionName = "";
            activeSubjectName = "";
            activeQrToken = "";
            activeGraceMinutes = DefaultGraceMinutes;
            activeExpirationMinutes = DefaultExpirationMinutes;

            await ClearActiveSessionAsync();

            message = "Session closed successfully.";
            messageSeverity = Severity.Success;

            Snackbar.Add(message, Severity.Success);

            await LoadDashboardAsync();
            await LoadSessionHistoryAsync();
            await LoadAttendanceBySessionAsync(closedSessionId, false);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to close session: {ex.Message}", Severity.Error);
        }
        finally
        {
            isClosingSession = false;
        }
    }

