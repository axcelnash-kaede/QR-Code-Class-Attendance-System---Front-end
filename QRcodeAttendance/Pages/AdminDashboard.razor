@page "/admin_dashboard"

@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

@using System.Net.Http.Headers
@using System.Net.Http.Json
@using System.Text.RegularExpressions

<div class="admin-pro">

    <aside class="admin-sidebar">
        <div class="brand-box">
            <div class="brand-icon">QR</div>
            <div>
                <h3>QR Attendance</h3>
                <span>Administrator Panel</span>
            </div>
        </div>

        <nav>
            <button type="button" @onclick="@(() => ScrollTo("overview"))">Overview</button>

            <button type="button" @onclick="@(() => ScrollTo("createTeacher"))">Add Teacher</button>
            <button type="button" @onclick="@(() => ScrollTo("createStudent"))">Add Student</button>
            <button type="button" @onclick="@(() => ScrollTo("addSubject"))">Add Subject</button>
            <button type="button" @onclick="@(() => ScrollTo("addSection"))">Add Section</button>
            <button type="button" @onclick="@(() => ScrollTo("assignSubject"))">Assign Subject</button>

            <button type="button" @onclick="@(() => ScrollTo("teacherAssignments"))">Teacher Assignments</button>
            <button type="button" @onclick="@(() => ScrollTo("approvals"))">Approvals List</button>
            <button type="button" @onclick="@(() => ScrollTo("teachers"))">Teachers List</button>
            <button type="button" @onclick="@(() => ScrollTo("students"))">Students List</button>
            <button type="button" @onclick="@(() => ScrollTo("subjectsList"))">Subjects List</button>
            <button type="button" @onclick="@(() => ScrollTo("sectionsList"))">Sections List</button>
        </nav>

        <button type="button" class="sidebar-logout" @onclick="Logout">Log Out</button>
    </aside>

    <main class="admin-main">

        <section class="hero-panel" id="overview">
            <div>
                <div class="eyebrow">Administrator Panel</div>
                <h1>Admin Dashboard</h1>
                <p>Add teachers, students, subjects, sections, and manage teacher-specific section/subject assignments.</p>
            </div>

            <button type="button" class="refresh-btn" @onclick="LoadAll">
                Refresh Data
            </button>
        </section>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="toast error">@errorMessage</div>
        }

        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <div class="toast success">@successMessage</div>
        }

        <section class="stats-grid">
            <div class="stat-card-pro">
                <div class="stat-icon">👨‍🎓</div>
                <span>Total Students</span>
                <strong>@dashboard.TotalStudents</strong>
            </div>

            <div class="stat-card-pro">
                <div class="stat-icon">👨‍🏫</div>
                <span>Total Teachers</span>
                <strong>@dashboard.TotalTeachers</strong>
            </div>

            <div class="stat-card-pro">
                <div class="stat-icon">📚</div>
                <span>Total Subjects</span>
                <strong>@subjects.Count</strong>
            </div>

            <div class="stat-card-pro">
                <div class="stat-icon">🧩</div>
                <span>Assignments</span>
                <strong>@teacherAssignments.Count</strong>
            </div>
        </section>

        <!-- ADD TEACHER + STUDENT -->
        <section class="form-grid">

            <div class="glass-card" id="createTeacher">
                <div class="card-head">
                    <div>
                        <h2>Add Teacher</h2>
                        <p>Create teacher account and automatically assign section/subject.</p>
                    </div>
                    <span class="card-chip">Teacher</span>
                </div>

                <div class="form-stack">
                    <input placeholder="Full Name" @bind="teacherForm.FullName" @bind:event="oninput" />
                    <input placeholder="Email Address" @bind="teacherForm.Email" @bind:event="oninput" />
                    <input placeholder="Password" type="password" @bind="teacherForm.Password" @bind:event="oninput" />

                    <select @bind="teacherForm.SectionId">
                        <option value="0">Select Section</option>
                        @foreach (var sec in sections)
                        {
                            <option value="@sec.Id">@sec.Name</option>
                        }
                    </select>

                    <select @bind="teacherForm.SubjectId">
                        <option value="0">Select Subject</option>
                        @foreach (var subject in subjects)
                        {
                            <option value="@subject.Id">@GetSubjectName(subject)</option>
                        }
                    </select>

                    <button type="button" class="primary-action" @onclick="CreateTeacher">
                        Create Teacher
                    </button>
                </div>
            </div>

            <div class="glass-card" id="createStudent">
                <div class="card-head">
                    <div>
                        <h2>Add Student</h2>
                        <p>Create, auto-approve, and enroll student to selected subject.</p>
                    </div>
                    <span class="card-chip green">Student</span>
                </div>

                <div class="form-stack">
                    <input placeholder="Full Name" @bind="studentForm.FullName" @bind:event="oninput" />
                    <input placeholder="Email Address" @bind="studentForm.Email" @bind:event="oninput" />
                    <input placeholder="Password" type="password" @bind="studentForm.Password" @bind:event="oninput" />
                    <input placeholder="Student Number e.g. 0001" maxlength="4" inputmode="numeric" @bind="studentForm.StudentId" @bind:event="oninput" />

                    <select @bind="studentForm.SectionId">
                        <option value="0">Select Section</option>
                        @foreach (var sec in sections)
                        {
                            <option value="@sec.Id">@sec.Name</option>
                        }
                    </select>

                    <select @bind="studentForm.SubjectId">
                        <option value="0">Select Subject</option>
                        @foreach (var subject in subjects)
                        {
                            <option value="@subject.Id">@subject.SubjectName</option>
                        }
                    </select>

                    <button type="button" class="primary-action" @onclick="CreateStudent">
                        Create Student
                    </button>
                </div>
            </div>

        </section>

        <!-- ADD SUBJECT + SECTION -->
        <section class="form-grid">

            <div class="glass-card" id="addSubject">
                <div class="card-head">
                    <div>
                        <h2>Add Subject</h2>
                        <p>Add reusable subjects manually.</p>
                    </div>
                    <span class="card-chip">Subject</span>
                </div>

                <div class="form-stack">
                    <input class="admin-input"
                           placeholder="Enter subject name"
                           @bind="newSubjectName"
                           @bind:event="oninput" />

                    <button type="button"
                            class="primary-action"
                            disabled="@isCreatingSubject"
                            @onclick="CreateSubject">
                        @(isCreatingSubject ? "Saving..." : "Add Subject")
                    </button>
                </div>
            </div>

            <div class="glass-card" id="addSection">
                <div class="card-head">
                    <div>
                        <h2>Add Section</h2>
                        <p>Create sections manually.</p>
                    </div>
                    <span class="card-chip green">Section</span>
                </div>

                <div class="form-stack">
                    <input class="admin-input"
                           placeholder="Enter section name"
                           @bind="newSectionName"
                           @bind:event="oninput" />

                    <button type="button"
                            class="primary-action"
                            disabled="@isCreatingSection"
                            @onclick="CreateSection">
                        @(isCreatingSection ? "Saving..." : "Add Section")
                    </button>
                </div>
            </div>

        </section>

        <!-- ASSIGN SUBJECT -->
        <section class="glass-card" id="assignSubject">
            <div class="card-head">
                <div>
                    <h2>Add Assign Subject</h2>
                    <p>Assign a teacher to one specific section and subject.</p>
                </div>
                <span class="card-chip">Assign</span>
            </div>

            <div class="form-stack">
                <select @bind="assignForm.TeacherId">
                    <option value="0">Select Teacher</option>
                    @foreach (var teacher in teachers.Where(t => t.IsActive))
                    {
                        <option value="@teacher.Id">@teacher.FullName</option>
                    }
                </select>

                <select @bind="assignForm.SectionId">
                    <option value="0">Select Section</option>
                    @foreach (var sec in sections)
                    {
                        <option value="@sec.Id">@sec.Name</option>
                    }
                </select>

                <select @bind="assignForm.SubjectId">
                    <option value="0">Select Subject</option>
                    @foreach (var subject in subjects)
                    {
                        <option value="@subject.Id">@subject.SubjectName</option>
                    }
                </select>

                <button type="button" class="primary-action" @onclick="AssignSubject">
                    Assign Subject
                </button>
            </div>
        </section>

        <!-- TEACHER ASSIGNMENTS LIST -->
        <section class="glass-card table-card-pro" id="teacherAssignments">
            <div class="table-header-pro">
                <div>
                    <h2>Teacher Assignments List</h2>
                    <p>Manage teacher section and subject assignments.</p>
                </div>

                <button type="button" class="outline-action" @onclick="LoadTeacherAssignments">
                    Refresh
                </button>
            </div>

            @if (teacherAssignments.Count == 0)
            {
                <div class="empty-state">No teacher assignments found.</div>
            }
            else
            {
                <div class="table-wrap-pro scrollable-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Teacher</th>
                                <th>Section</th>
                                <th>Subject</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var item in teacherAssignments.OrderBy(x => x.TeacherName).ThenBy(x => x.SectionName).ThenBy(x => x.SubjectName))
                            {
                                <tr>
                                    <td>@item.TeacherName</td>
                                    <td>@item.SectionName</td>
                                    <td>@item.SubjectName</td>
                                    <td>
                                        <div class="actions">
                                            <button type="button"
                                                    class="approve-btn"
                                                    @onclick="() => EditTeacherAssignment(item)">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="reject-btn"
                                                    @onclick="() => RemoveTeacherAssignment(item.Id)">
                                                Remove
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <!-- APPROVALS LIST -->
        <section class="glass-card table-card-pro" id="approvals">
            <div class="table-header-pro">
                <div>
                    <h2>Approvals List</h2>
                    <p>Approve or reject student mobile registrations.</p>
                </div>

                <button type="button" class="outline-action" @onclick="LoadPendingStudents">
                    Refresh
                </button>
            </div>

            @if (pendingStudents.Count == 0)
            {
                <div class="empty-state">No pending student registrations.</div>
            }
            else
            {
                <div class="table-wrap-pro scrollable-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Student ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Section</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var student in pendingStudents)
                            {
                                <tr>
                                    <td>@FormatStudentId(student.StudentId)</td>
                                    <td>@student.FullName</td>
                                    <td>@student.Email</td>
                                    <td>@DisplayText(student.SectionName, "No section")</td>
                                    <td>
                                        <div class="actions">
                                            <button type="button"
                                                    class="approve-btn"
                                                    disabled="@isProcessingApproval"
                                                    @onclick="() => ApproveStudent(student.Id)">
                                                @(isProcessingApproval ? "..." : "Approve")
                                            </button>

                                            <button type="button"
                                                    class="reject-btn"
                                                    disabled="@isProcessingApproval"
                                                    @onclick="() => RejectStudent(student.Id)">
                                                @(isProcessingApproval ? "..." : "Reject")
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <!-- TEACHERS LIST -->
        <section class="glass-card table-card-pro" id="teachers">
            <div class="table-header-pro">
                <div>
                    <h2>Teachers List</h2>
                    <p>Registered teacher accounts.</p>
                </div>

                <button type="button" class="outline-action" @onclick="LoadTeachers">
                    Refresh
                </button>
            </div>

            @if (teachers.Count == 0)
            {
                <div class="empty-state">No teachers found.</div>
            }
            else
            {
                <div class="table-wrap-pro scrollable-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Teacher ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Assignments</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var teacher in teachers)
                            {
                                <tr class="@(!teacher.IsActive ? "inactive-row" : "")">
                                    <td>@DisplayText(teacher.StudentId, "-")</td>
                                    <td>@teacher.FullName</td>
                                    <td>@teacher.Email</td>
                                    <td>@GetTeacherAssignments(teacher.Id)</td>
                                    <td>
                                        <span class="status @(teacher.IsActive ? "approved" : "rejected")">
                                            @(teacher.IsActive ? "Active" : "Removed")
                                        </span>
                                    </td>
                                    <td>
                                        @if (teacher.IsActive)
                                        {
                                            <button type="button"
                                                    class="reject-btn"
                                                    @onclick="() => RemoveTeacher(teacher.Id)">
                                                Remove
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="approve-btn"
                                                    @onclick="() => RestoreUser(teacher.Id)">
                                                Restore
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <!-- STUDENTS LIST -->
        <section class="glass-card table-card-pro" id="students">
            <div class="table-header-pro">
                <div>
                    <h2>Students List</h2>
                    <p>Registered student accounts.</p>
                </div>

                <button type="button" class="outline-action" @onclick="LoadStudents">
                    Refresh
                </button>
            </div>

            @if (students.Count == 0)
            {
                <div class="empty-state">No students found.</div>
            }
            else
            {
                <div class="table-wrap-pro scrollable-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Student ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Section</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var student in students)
                            {
                                <tr class="@(!student.IsActive ? "inactive-row" : "")">
                                    <td>@FormatStudentId(student.StudentId)</td>
                                    <td>@student.FullName</td>
                                    <td>@student.Email</td>
                                    <td>@DisplayText(student.SectionName, "No section")</td>
                                    <td>
                                        <span class="status @(student.IsActive ? "approved" : "rejected")">
                                            @(student.IsActive ? "Active" : "Dropped")
                                        </span>
                                    </td>
                                    <td>
                                        @if (student.IsActive)
                                        {
                                            <button type="button"
                                                    class="reject-btn"
                                                    @onclick="() => DropStudent(student.Id)">
                                                Drop
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="approve-btn"
                                                    @onclick="() => RestoreUser(student.Id)">
                                                Restore
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <!-- SUBJECTS LIST -->
        <section class="glass-card table-card-pro" id="subjectsList">
            <div class="table-header-pro">
                <div>
                    <h2>Subjects List</h2>
                    <p>View, edit, and remove subjects.</p>
                </div>

                <button type="button" class="outline-action" @onclick="LoadSubjects">
                    Refresh
                </button>
            </div>

            @if (subjects.Count == 0)
            {
                <div class="empty-state">No subjects found.</div>
            }
            else
            {
                <div class="table-wrap-pro scrollable-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Subject ID</th>
                                <th>Subject Name</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var subject in subjects.OrderBy(s => s.Id))
                            {
                                <tr>
                                    <td>@subject.Id</td>
                                    <td>@subject.SubjectName</td>
                                    <td>
                                        <div class="actions">
                                            <button type="button"
                                                    class="approve-btn"
                                                    @onclick="() => EditSubject(subject)">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="reject-btn"
                                                    @onclick="() => RemoveSubject(subject.Id)">
                                                Remove
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <!-- SECTIONS LIST -->
        <section class="glass-card table-card-pro" id="sectionsList">
            <div class="table-header-pro">
                <div>
                    <h2>Sections List</h2>
                    <p>View, edit, and remove sections.</p>
                </div>

                <button type="button" class="outline-action" @onclick="LoadSections">
                    Refresh
                </button>
            </div>

            @if (sections.Count == 0)
            {
                <div class="empty-state">No sections found.</div>
            }
            else
            {
                <div class="table-wrap-pro scrollable-table">
                    <table>
                        <thead>
                            <tr>
                                <th>Section ID</th>
                                <th>Section Name</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var sec in sections.OrderBy(s => s.Id))
                            {
                                <tr>
                                    <td>@sec.Id</td>
                                    <td>@sec.Name</td>
                                    <td>
                                        <div class="actions">
                                            <button type="button"
                                                    class="approve-btn"
                                                    @onclick="() => EditSection(sec)">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="reject-btn"
                                                    @onclick="() => RemoveSection(sec.Id)">
                                                Remove
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

    </main>
</div>

@if (isEditModalOpen)
{
    <div class="custom-modal-backdrop">
        <div class="custom-modal">
            <h3>@editModalTitle</h3>
            <p>@editModalSubtitle</p>

            <input class="admin-input"
                   placeholder="Enter new name"
                   @bind="editName"
                   @bind:event="oninput" />

            <div class="modal-actions">
                <button type="button" class="outline-action" @onclick="CloseEditModal">
                    Cancel
                </button>

                <button type="button" class="approve-btn" @onclick="SaveEditModal">
                    Save Changes
                </button>
            </div>
        </div>
    </div>
}

@if (isAssignmentModalOpen)
{
    <div class="custom-modal-backdrop">
        <div class="custom-modal">
            <h3>Edit Teacher Assignment</h3>
            <p>Update the teacher, section, and subject assignment.</p>

            <div class="form-stack">
                <select @bind="editAssignmentForm.TeacherId">
                    <option value="0">Select Teacher</option>
                    @foreach (var teacher in teachers.Where(t => t.IsActive))
                    {
                        <option value="@teacher.Id">@teacher.FullName</option>
                    }
                </select>

                <select @bind="editAssignmentForm.SectionId">
                    <option value="0">Select Section</option>
                    @foreach (var sec in sections)
                    {
                        <option value="@sec.Id">@sec.Name</option>
                    }
                </select>

                <select @bind="editAssignmentForm.SubjectId">
                    <option value="0">Select Subject</option>
                    @foreach (var subject in subjects)
                    {
                        <option value="@subject.Id">@subject.SubjectName</option>
                    }
                </select>
            </div>

            <div class="modal-actions">
                <button type="button" class="outline-action" @onclick="CloseAssignmentModal">
                    Cancel
                </button>

                <button type="button" class="approve-btn" @onclick="SaveTeacherAssignment">
                    Save Changes
                </button>
            </div>
        </div>
    </div>
}

@if (isConfirmModalOpen)
{
    <div class="custom-modal-backdrop">
        <div class="custom-modal">
            <h3>@confirmTitle</h3>
            <p>@confirmMessage</p>

            <div class="modal-actions">
                <button type="button" class="outline-action" @onclick="CloseConfirmModal">
                    Cancel
                </button>

                <button type="button" class="@confirmButtonClass" @onclick="RunConfirmAction">
                    @confirmButtonText
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool isEditModalOpen;
    private string editType = "";
    private int editId;
    private string editName = "";
    private string editModalTitle = "";
    private string editModalSubtitle = "";
    private string confirmButtonClass = "reject-btn";

    private bool isAssignmentModalOpen;
    private int editAssignmentId;
    private AdminAssignSubjectDto editAssignmentForm = new();

    private bool isConfirmModalOpen;
    private string confirmTitle = "";
    private string confirmMessage = "";
    private string confirmButtonText = "Confirm";
    private Func<Task>? confirmAction;

    private DashboardDto dashboard = new();
    private TeacherCreateDto teacherForm = new();
    private StudentCreateDto studentForm = new() { AutoApprove = true };
    private AdminAssignSubjectDto assignForm = new();

    private List<UserDto> teachers = new();
    private List<UserDto> students = new();
    private List<UserDto> pendingStudents = new();
    private List<SectionDto> sections = new();
    private List<SubjectDto> subjects = new();
    private List<TeacherAssignmentDto> teacherAssignments = new();

    private string? errorMessage;
    private string? successMessage;

    private string newSubjectName = "";
    private string newSectionName = "";

    private bool isProcessingApproval;
    private bool isCreatingSubject;
    private bool isCreatingSection;

    protected override async Task OnInitializedAsync()
    {
        await AttachToken();
        await LoadAll();
    }

    private async Task AttachToken()
    {
        var token = await JS.InvokeAsync<string>("localStorage.getItem", "token");

        if (string.IsNullOrWhiteSpace(token))
        {
            Nav.NavigateTo("/login");
            return;
        }

        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", token);
    }

    private async Task LoadAll()
    {
        ClearMessages();

        await LoadDashboard();
        await LoadSections();
        await LoadSubjects();
        await LoadTeachers();
        await LoadStudents();
        await LoadPendingStudents();
        await LoadTeacherAssignments();
    }

    private async Task LoadAllWithoutClearingMessages()
    {
        await LoadDashboard();
        await LoadSections();
        await LoadSubjects();
        await LoadTeachers();
        await LoadStudents();
        await LoadPendingStudents();
        await LoadTeacherAssignments();
    }

    private async Task LoadDashboard()
    {
        try
        {
            dashboard = await Http.GetFromJsonAsync<DashboardDto>("api/Dashboard/admin") ?? new();
        }
        catch
        {
            await ShowError("Failed to load dashboard.");
        }
    }

    private async Task LoadSections()
    {
        try
        {
            sections = await Http.GetFromJsonAsync<List<SectionDto>>("api/Admin/sections") ?? new();
        }
        catch
        {
            await ShowError("Failed to load sections.");
        }
    }

    private async Task LoadSubjects()
    {
        try
        {
            subjects = await Http.GetFromJsonAsync<List<SubjectDto>>("api/Admin/subjects") ?? new();
        }
        catch
        {
            await ShowError("Failed to load subjects.");
        }
    }

    private async Task LoadTeachers()
    {
        try
        {
            teachers = await Http.GetFromJsonAsync<List<UserDto>>("api/Admin/teachers") ?? new();
        }
        catch
        {
            await ShowError("Failed to load teachers.");
        }
    }

    private async Task LoadStudents()
    {
        try
        {
            students = await Http.GetFromJsonAsync<List<UserDto>>("api/Admin/students") ?? new();
        }
        catch
        {
            await ShowError("Failed to load students.");
        }
    }

    private async Task LoadPendingStudents()
    {
        try
