    private async Task CreateTeacher()
    {
        ClearMessages();

        teacherForm.FullName = CleanName(teacherForm.FullName);
        teacherForm.Email = CleanEmail(teacherForm.Email);

        if (string.IsNullOrWhiteSpace(teacherForm.FullName))
        {
            await ShowError("Teacher full name is required.");
            return;
        }

        if (!IsValidEmail(teacherForm.Email))
        {
            await ShowError("Please enter a valid teacher email address.");
            return;
        }

        if (IsDuplicateEmail(teacherForm.Email))
        {
            await ShowError("This email is already registered.");
            return;
        }

        if (!IsValidPassword(teacherForm.Password))
        {
            await ShowError("Password must be at least 6 characters.");
            return;
        }

        if (teacherForm.SectionId <= 0)
        {
            await ShowError("Please select a section for the teacher.");
            return;
        }

        if (teacherForm.SubjectId <= 0)
        {
            await ShowError("Please select a subject for the teacher.");
            return;
        }

        var response = await Http.PostAsJsonAsync("api/Admin/teachers", teacherForm);

        if (!response.IsSuccessStatusCode)
        {
            await ShowError(await ReadError(response, "Failed to create teacher."));
            return;
        }

        teacherForm = new TeacherCreateDto();

        await ShowSuccess("Teacher created successfully.");
        await LoadAllWithoutClearingMessages();
    }

    private async Task CreateStudent()
    {
        ClearMessages();

        studentForm.FullName = CleanName(studentForm.FullName);
        studentForm.Email = CleanEmail(studentForm.Email);
        studentForm.StudentId = CleanStudentId(studentForm.StudentId);

        if (string.IsNullOrWhiteSpace(studentForm.FullName))
        {
            await ShowError("Student full name is required.");
            return;
        }

        if (!IsValidEmail(studentForm.Email))
        {
            await ShowError("Please enter a valid student email address.");
            return;
        }

        if (IsDuplicateEmail(studentForm.Email))
        {
            await ShowError("This email is already registered.");
            return;
        }

        if (!IsValidPassword(studentForm.Password))
        {
            await ShowError("Password must be at least 6 characters.");
            return;
        }

        if (!IsFourDigitStudentId(studentForm.StudentId))
        {
            await ShowError("Student number must be exactly 4 digits. Example: 0001.");
            return;
        }

        if (IsDuplicateStudentId(studentForm.StudentId))
        {
            await ShowError("This student number is already registered.");
            return;
        }

        if (studentForm.SectionId <= 0)
        {
            await ShowError("Please select a section for the student.");
            return;
        }

        if (studentForm.SubjectId <= 0)
        {
            await ShowError("Please select a subject for the student.");
            return;
        }

        var response = await Http.PostAsJsonAsync("api/Admin/students", studentForm);

        if (!response.IsSuccessStatusCode)
        {
            await ShowError(await ReadError(response, "Failed to create student."));
            return;
        }

        studentForm = new StudentCreateDto { AutoApprove = true };

        await ShowSuccess("Student created and enrolled successfully.");
        await LoadAllWithoutClearingMessages();
    }

